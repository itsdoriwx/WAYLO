section.hero
  .container
    .hero__content
      h1.hero__title Мандруй за межі звичного
      p.hero__text Готові й власні тури Україною та світом. Обираєш, сплачуєш - і тебе вже чекає незабутній відпочинок.

      form.hero__search(action="/tours.html" method="get")
        .hero__select-wrap
          select.hero__select(name="month" aria-label="Місяць поїздки")
            option(value="") Будь-який місяць
            each m, i in ['Січень','Лютий','Березень','Квітень','Травень','Червень','Липень','Серпень','Вересень','Жовтень','Листопад','Грудень']
              option(value=i + 1)= m
        button.hero__btn(type="submit") Знайти тур

    .hero__frame
      .hero__frame-photo

-
  const categories = [
    { id: 'all', label: 'Усі' },
    { id: 'mountains', label: 'Гори' },
    { id: 'sea', label: 'Море' },
    { id: 'excursion', label: 'Екскурсійні' },
    { id: 'holiday', label: 'Святкові' }
  ]

section.tours
  .container
    h2.section-title Обери свою особливу подорож
    .chips
      each c, i in categories
        button.chip(type="button" data-filter=c.id class=i === 0 ? 'chip--active' : '')= c.label

    //- картки (тури з featured у tours.json) створює скрипт home.ts
    .tours__grid#homeGrid
      a.tours__all(href="/tours.html")
        span.tours__all-title Дивитись усі тури
        span.tours__all-sub 50 + напрямків
        span.tours__all-btn
          svg(viewBox="0 0 44 26" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round")
            line(x1="4" y1="13" x2="38" y2="13")
            polyline(points="27,3 38,13 27,23")

-
  const features = [
    'Готові тури з програмою по днях, задля вашого спокою.',
    'Електронний квиток і ваучер одразу після оплати, що зберігається у вашому кабінеті навіть за відсутності зв’язку.',
    'Враження за поїздку, що дають персональні знижки.',
    'Доступ до WAYLO market, де ви зможете придбати товари в подорож.'
  ]
  const stats = [
    { num: '12k+', label: 'задоволених мандрівників' },
    { num: '50+', label: 'діючих напрямків' },
    { num: '4.9', label: 'середня оцінка турів' },
    { num: '24/7', label: 'підтримка подорожуючих' }
  ]

section.about
  .container.about__inner
    .about__info
      h2.about__title Про WAYLO
      p.about__lead WAYLO - туристична платформа, де всю поїздку від А до Я ви можете обрати й спланувати в одному місці: без черг, зайвих дзвінків чи комісій - усе задля вашого комфорту!
      ul.about__list
        each f in features
          li.about__item
            svg.about__check(viewBox="0 0 40 40" fill="none")
              circle(cx="20" cy="20" r="20" fill="#DCE6EF")
              polyline(points="12,21 18,27 28,14" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round")
            span= f

    .about__stats
      each s in stats
        .stat
          .stat__num= s.num
          .stat__label= s.label

section.journey
  .container
    .journey__box
      h2.journey__title Карта ваших вражень
      p.journey__sub Три кроки - і ви вже в дорозі.
      svg.journey__svg(viewBox="0 0 1400 260" fill="none" aria-hidden="true")
        path(d="M170 60 C 330 80, 520 165, 690 168 C 880 172, 930 15, 1100 35 C 1160 43, 1195 62, 1225 80" stroke="#fff" stroke-width="3" stroke-dasharray="2 10" stroke-linecap="round")
        circle(cx="170" cy="60" r="18" fill="#1F3556" stroke="#fff" stroke-width="3")
        circle(cx="690" cy="168" r="18" fill="#1F3556" stroke="#fff" stroke-width="3")
        circle(cx="1225" cy="80" r="18" fill="#1F3556" stroke="#fff" stroke-width="3")

        text.journey__label(x="170" y="112" text-anchor="middle") Знайти свій тур
        text.journey__label(x="690" y="220" text-anchor="middle") Оформити подорож
        text.journey__label(x="1225" y="132" text-anchor="middle") Підготуйся до
        text.journey__label(x="1225" y="160" text-anchor="middle") незабутніх емоцій
     
      ol.journey__steps
        li Знайти свій тур
        li Оформити подорож
        li Підготуйся до незабутніх емоцій
