- const activePage = 'tours'
include header.pug

main.tour-details-page
  .details-container
    a.details-back-link(href="/tours.html")
      svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
        line(x1="19" y1="12" x2="5" y2="12")
        polyline(points="12 19 5 12 12 5")
      span Назад до всіх турів

    .details-gallery
      .details-gallery__main.details-gallery__item--0
        button.details-gallery__arrow.details-gallery__arrow--prev(type="button" aria-label="Попереднє фото") ‹
        button.details-gallery__arrow.details-gallery__arrow--next(type="button" aria-label="Наступне фото") ›
        span.details-gallery__label сюди фото Нью-Йорка
        .details-gallery__dots
          span.details-gallery__dot.details-gallery__dot--active
          span.details-gallery__dot
          span.details-gallery__dot

      .details-gallery__side
        .details-gallery__item.details-gallery__item--square
          span.details-gallery__label сюди фото Нью-Йорка

    .details-grid
      .details-info
        h1.details-info__title США: Мегаполіс Нью-Йорк

        .details-info__meta-row
          .details-info__meta
            span США
            span.details-info__divider |
            span 8 днів
            span.details-info__divider |
            span група до 12 осіб

          .details-info__rating
            span.details-info__star ★
            span.details-info__score 4.95
            a.details-info__reviews(href="#reviews") (184 відгуків)

        p.details-info__description
          | Хмарочоси Мангеттена, вечірні вогні Таймс-Сквер, затишна прогулянка Центральним парком та велична Статуя Свободи. Проживання в центрі, авіаквитки та супровід гіда включено.

        .details-program
          h2.details-program__title Програма по днях
          
          .details-program__tabs
            button.details-program__tab.details-program__tab--active(type="button" data-day="1") День 1
            button.details-program__tab(type="button" data-day="2") День 2
            button.details-program__tab(type="button" data-day="3") День 3
            button.details-program__tab(type="button" data-day="4") День 4

          .details-program__card
            .details-program__day-content(data-day-content="1")
              h3.details-program__day-title День 1 — Приліт та Таймс-Сквер
              ul.details-program__list
                li Прибуття до аеропорту JFK, трансфер до готелю на Мангеттені.
                li Вечірня прогулянка сяючим Таймс-Сквер та перша американська вечеря.

            .details-program__day-content(data-day-content="2" hidden)
              h3.details-program__day-title День 2 — Статуя Свободи та Фінансовий квартал
              ul.details-program__list
                li Круїз на поромі до острова Свободи та Елліс-Айленд.
                li Прогулянка Волл-стріт, знаменитий Атакуючий бик та Меморіал 9/11.

            .details-program__day-content(data-day-content="3" hidden)
              h3.details-program__day-title День 3 — Центральний парк та оглядовий майданчик
              ul.details-program__list
                li Прогулянка Центральним парком і відвідування музею Метрополітен.
                li Підйом на оглядовий майданчик Top of the Rock (Рокфеллер-центр).

            .details-program__day-content(data-day-content="4" hidden)
              h3.details-program__day-title День 4 — Бруклінський міст та виліт додому
              ul.details-program__list
                li Піша прогулянка Бруклінським мостом та шопінг на П'ятій авеню.
                li Трансфер до аеропорту та виліт.

        .details-combined-card
          .details-combined-card__col
            .details-combined-card__header
              h3.details-combined-card__title Включено в ціну
            .details-combined-card__tags
              span.details-tag Авіапереліт
              span.details-tag Готель 4* (7 ночей)
              span.details-tag Сніданки
              span.details-tag Медстрахування
              span.details-tag Статуя Свободи

          .details-combined-card__divider

          .details-combined-card__col
            .details-combined-card__header
              h3.details-combined-card__title За бажанням
              .details-info-tooltip
                span.details-info-tooltip__icon(title="Оплата відбувається готівкою гіду на місці") i
            button.details-modal-btn(type="button" onclick="document.getElementById('activitiesModal').style.display='flex'")
              | Дивитись усі активності

      aside.details-booking-card
        .details-booking-card__price-block
          .details-booking-card__price-row
            span#cardPrice.details-booking-card__price 42 000 грн
            span#cardOldPrice.details-booking-card__old-price 48 000 грн
          span.details-booking-card__per за особу

        .details-booking-card__group
          label.details-booking-card__label Дата виїзду
          
          .details-date-options
            label.details-date-option.details-date-option--selected(data-price="42000" data-discount="true")
              input(type="radio" name="tour_date" checked)
              span.details-date-option__text 10 грудня
              span.details-date-option__badge -12%
              span.details-date-option__seats місць: 4

            label.details-date-option(data-price="48000" data-discount="false")
              input(type="radio" name="tour_date")
              span.details-date-option__text 15 січня
              span.details-date-option__seats місць: 8

        button.details-question-btn(type="button")
          span Є питання?

.details-sticky-bar
  .details-sticky-bar__container
    .details-sticky-bar__info
      .details-sticky-bar__price-group
        span#stickyPrice.details-sticky-bar__price 42 000 грн
        span.details-sticky-bar__sub за особу
    
    .details-sticky-bar__actions
      a.details-btn.details-btn--outline(href="/booking.html?type=reserve") Забронювати
      a.details-btn.details-btn--primary(href="/booking.html?type=pay") Оплатити

#activitiesModal.details-modal(style="display: none;")
  .details-modal__overlay(onclick="document.getElementById('activitiesModal').style.display='none'")
  .details-modal__content
    button.details-modal__close(type="button" onclick="document.getElementById('activitiesModal').style.display='none'") ×
    h3.details-modal__title Додаткові активності
    
    ul.details-modal__list
      li
        span Мюзикл на Бродвеї
        strong + 4 500 грн
      li
        span Політ на гелікоптері над Мангеттеном
        strong + 8 200 грн
      li
        span Екскурсія в Музей MOMA
        strong + 1 200 грн