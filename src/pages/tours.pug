doctype html
html(lang="uk")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title WAYLO | Готові тури
  body
    - const activePage = 'tours'
    include header.pug

    main.tours-catalog-page
      .tours-container
        h1.tours-catalog-page__title Готові тури

        form#toursFilters.tours-filters(novalidate)
          .tours-filters__group.tours-filters__group--dir
            label.tours-filters__label(for="filterQuery") Напрямок
            input#filterQuery.tours-filters__input(type="text" placeholder="Куди бажаєте вирушити?")
          
          .tours-filters__group.tours-filters__group--price
            label.tours-filters__label(for="filterPriceFrom") Вартість від
            input#filterPriceFrom.tours-filters__input(type="number" min="0" placeholder="0")
            
          .tours-filters__group.tours-filters__group--price
            label.tours-filters__label(for="filterPriceTo") Вартість до
            input#filterPriceTo.tours-filters__input(type="number" min="0" placeholder="50000")

          .tours-filters__group.tours-filters__group--currency
            label.tours-filters__label(for="filterCurrency") Валюта
            .tours-filters__select-wrap
              select#filterCurrency.tours-filters__select
                option(value="UAH") UAH (грн)
                option(value="USD") USD ($)
                option(value="EUR") EUR (€)
            
          .tours-filters__group.tours-filters__group--days
            label.tours-filters__label(for="filterDays") Тривалість (дні)
            input#filterDays.tours-filters__input(type="number" min="1" max="365" placeholder="від 1 до 365")

          button.tours-filters__btn(type="submit") Застосувати

        p.tours-filters__error#filtersError(hidden)

        //- мітка активного місяця (прийшли з головної)
        .tours-month-tag#monthTag(hidden)
          span#monthTagText
          button#monthTagClear(type="button" aria-label="Скинути місяць") ×

        //- картки створює catalog.ts
        .tours-catalog__grid#toursGrid
        p.tours-catalog__empty#toursEmpty(hidden) За вашими параметрами турів не знайдено. Спробуйте змінити фільтри.
