              h3.tour-card__title Греція: Сонячне Санторіні
              p.tour-card__meta Греція | 7 днів
              .tour-card__row
                span.tour-card__price від 22 000 грн
                a.tour-card__btn(href="#") Деталі

          //- 8
          article.tour-card
            .tour-card__img.tour-card__img--1
