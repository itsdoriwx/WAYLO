doctype html
html(lang="uk")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title WAYLO | Деталі туру
  body
    - const activePage = 'tours'
    include header.pug

    main.tour-details-page#tourPage
      .details-container
        a.details-back-link(href="/tours.html")
          svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
            line(x1="19" y1="12" x2="5" y2="12")
            polyline(points="12 19 5 12 12 5")
          span Назад до всіх турів

        .details-gallery
          .details-gallery__main#galleryMain
            button.details-gallery__arrow.details-gallery__arrow--prev#galleryPrev(type="button" aria-label="Попереднє фото") ‹
            button.details-gallery__arrow.details-gallery__arrow--next#galleryNext(type="button" aria-label="Наступне фото") ›
            .details-gallery__dots#galleryDots

          .details-gallery__side
            .details-gallery__item.details-gallery__item--square#gallerySide

        .details-grid
          .details-info
            h1.details-info__title#detTitle

            .details-info__meta-row
              .details-info__meta#detMeta

              .details-info__rating
                span.details-info__star ★
                span.details-info__score#detScore
                a.details-info__reviews#detReviews(href="#reviews")

            p.details-info__description#detDescription

            .details-program
              h2.details-program__title Програма по днях
              .details-program__tabs#programTabs
              .details-program__card#programCard

            .details-combined-card
              .details-combined-card__col
                .details-combined-card__header
                  h3.details-combined-card__title Включено у вартість
                .details-combined-card__tags#includedTags

              .details-combined-card__divider

              .details-combined-card__col
                .details-combined-card__header
                  h3.details-combined-card__title За бажанням
                button.details-modal-btn#openActivities(type="button") Дивитись усі активності

          aside.details-booking-card
            .details-booking-card__price-block
              .details-booking-card__price-row
                span#cardPrice.details-booking-card__price
                span#cardOldPrice.details-booking-card__old-price
              span.details-booking-card__per за особу

            .details-booking-card__group
              label.details-booking-card__label Дата виїзду
              .details-date-options#dateOptions

            button.details-question-btn(type="button")
              span Є питання?

    .details-sticky-bar
      .details-sticky-bar__container
        .details-sticky-bar__info
          .details-sticky-bar__price-group
            span#stickyPrice.details-sticky-bar__price
            span.details-sticky-bar__sub за особу
        .details-sticky-bar__actions
          a.details-btn.details-btn--outline#btnReserve(href="/booking.html") Забронювати
          a.details-btn.details-btn--primary#btnPay(href="/booking.html") Оплатити

    #activitiesModal.details-modal(style="display: none;")
      .details-modal__overlay#modalOverlay
      .details-modal__content
        button.details-modal__close#modalClose(type="button" aria-label="Закрити") ×
        h3.details-modal__title Додаткові активності
        ul.details-modal__list#activitiesList
